# Trainer — local / Compose env (copy to .env)
# Never commit real secrets. Prefer: bash scripts/gen_dev_env.sh
# Or: cp .env.example .env and fill empty values in your private .env (gitignored).

# --- PostgreSQL (Compose service `db`) ---
POSTGRES_USER=trainer
POSTGRES_PASSWORD=
POSTGRES_DB=trainer
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Runtime ORM role (DML only; subject to RLS on body_measurements)
TRAINER_APP_PASSWORD=
# Optional override; if empty, app builds DSN from TRAINER_APP_PASSWORD + POSTGRES_*
DATABASE_URL=

# Alembic / DDL bootstrap (uses POSTGRES_* until roles exist)
TRAINER_MIGRATOR_PASSWORD=
# Optional override; if empty, app builds DSN from POSTGRES_USER + POSTGRES_PASSWORD
ALEMBIC_DATABASE_URL=

# --- App ---
# development | staging | production
# production/staging: API refuses to boot with RATE_LIMIT_STORE=memory,
# empty CSRF/Google secrets, or PUBLIC_ORIGIN / GOOGLE_REDIRECT_URI on localhost.
APP_ENV=development
PUBLIC_ORIGIN=https://localhost
LOG_LEVEL=info

# --- Auth / session (FR-001, FR-005a/d) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://localhost/api/auth/google/callback
SESSION_COOKIE_NAME=__Host-trainer_session
CSRF_SECRET=

# --- Rate limit (FR-005c) ---
# memory = local/tests only; production = postgres (rate_limit_buckets)
RATE_LIMIT_STORE=memory

# --- Ops: backup / purge (FR-081a, FR-006c) — Compose profile `ops` ---
# Required for `docker compose --profile ops run --rm backup`
BACKUP_ENCRYPTION_PASSPHRASE=
# Optional alternative to passphrase (needs `age` in the backup image)
BACKUP_AGE_RECIPIENT=
BACKUP_RETENTION_DAYS=30
# Optional heartbeat file path inside purge container
PURGE_HEARTBEAT_PATH=
# Optional heartbeat for satellite daily-outcome finalizer (FR-053)
SATELLITE_FINALIZE_HEARTBEAT_PATH=
SATELLITE_FINALIZE_LIMIT=500
