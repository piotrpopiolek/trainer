# Trainer — local / Compose env (copy to .env)
# Never commit real secrets. Copy: cp .env.example .env
# Then fill empty values in your private .env (gitignored).

# --- PostgreSQL (Compose service `db`) ---
POSTGRES_USER=trainer
POSTGRES_PASSWORD=
POSTGRES_DB=trainer

# Runtime ORM role (DML only; subject to RLS on body_measurements)
TRAINER_APP_PASSWORD=
DATABASE_URL=

# Alembic / DDL (BYPASSRLS). Bootstrap uses POSTGRES_USER until roles exist.
TRAINER_MIGRATOR_PASSWORD=
ALEMBIC_DATABASE_URL=

# --- App ---
APP_ENV=development
PUBLIC_ORIGIN=https://localhost
LOG_LEVEL=info

# --- Auth / session (FR-001, FR-005a/d) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://localhost/api/auth/google/callback
SESSION_COOKIE_NAME=__Host-trainer_session
CSRF_SECRET=

# --- Rate limit (FR-005c) ---
# memory = local/tests only; production = postgres (rate_limit_buckets)
RATE_LIMIT_STORE=memory
